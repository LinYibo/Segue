{
  // Static hosting for trysegue.com (same shape as GitTasks' `gittasks`
  // worker): the vite build output served as Workers static assets, no
  // script. `npm run deploy` after editing (vite build + wrangler deploy).
  "name": "segue",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  }
}
